        <ui:Label text="" name="RankingList" style="width: 94%; flex-grow: 1; flex-shrink: 1; font-size: 10px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/UI/Galmuri11-Condensed.ttf?fileID=12800000&amp;guid=8309e514c63e1b14abc088425cd0760b&amp;type=3#Galmuri11-Condensed&quot;); -unity-text-align: upper-left; white-space: pre; overflow: hidden;"/>
        <ui:Label text="YOUR RANK : TOPGUN" name="CurrentRank" style="width: 94%; flex-shrink: 1; font-size: 12px; color: rgb(6, 238, 71); -unity-font-definition: url(&quot;project://database/Assets/UI/Galmuri11-Condensed.ttf?fileID=12800000&amp;guid=8309e514c63e1b14abc088425cd0760b&amp;type=3#Galmuri11-Condensed&quot;); -unity-text-align: middle-center; margin-top: 6px;"/>
