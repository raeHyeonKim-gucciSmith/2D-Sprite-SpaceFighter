        </ui:VisualElement>
        <ui:Button text="RESTART" name="RestartButton" double-click-selects-word="true" style="width: 42%; height: 31px; margin-top: 18px; background-color: rgb(255, 255, 255); color: rgb(0, 0, 0); -unity-font-definition: url(&quot;project://database/Assets/UI/Galmuri11-Condensed.ttf?fileID=12800000&amp;guid=8309e514c63e1b14abc088425cd0760b&amp;type=3#Galmuri11-Condensed&quot;); font-size: 11px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(255, 48, 38); border-right-color: rgb(255, 48, 38); border-top-color: rgb(255, 48, 38); border-bottom-color: rgb(255, 48, 38);"/>
    </ui:VisualElement>
