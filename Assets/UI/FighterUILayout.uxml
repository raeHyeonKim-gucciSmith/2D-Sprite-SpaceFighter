<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="KILL : 0 " name="Score" parse-escape-sequences="false" style="align-content: flex-end; align-items: flex-start; -unity-text-align: middle-left; -unity-font-definition: url(&quot;project://database/Assets/UI/Galmuri11-Condensed.ttf?fileID=12800000&amp;guid=8309e514c63e1b14abc088425cd0760b&amp;type=3#Galmuri11-Condensed&quot;); font-size: 20px; color: rgb(6, 238, 71); bottom: 0%; position: absolute; left: 2%;"/>
