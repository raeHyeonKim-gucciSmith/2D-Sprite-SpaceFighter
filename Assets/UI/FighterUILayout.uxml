            <ui:Label text="VIPER 01" name="CombatOperatorMessage" style="font-size: 10px; color: rgb(255, 255, 255); white-space: normal; -unity-text-align: middle-left; -unity-font-definition: url(&quot;project://database/Assets/UI/Galmuri11-Condensed.ttf?fileID=12800000&amp;guid=8309e514c63e1b14abc088425cd0760b&amp;type=3#Galmuri11-Condensed&quot;);"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="GameOverEntryPanel" style="display: none; position: absolute; top: 14%; left: 3%; width: 42%; height: 72%; overflow: hidden; align-items: center; padding-top: 12px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgba(0, 0, 0, 0.9); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(255, 48, 38); border-right-color: rgb(255, 48, 38); border-bottom-color: rgb(255, 48, 38); border-left-color: rgb(255, 48, 38);">
        <ui:Label text="MISSION FAILED" name="Missonfailed" selectable="true" focusable="true" style="font-size: 20px; color: rgb(255, 48, 38); -unity-font-definition: url(&quot;project://database/Assets/UI/Galmuri11-Condensed.ttf?fileID=12800000&amp;guid=8309e514c63e1b14abc088425cd0760b&amp;type=3#Galmuri11-Condensed&quot;); -unity-text-align: middle-center; margin-bottom: 14px;"/>
        <ui:Label text="CURRENT SCORE : 0 KILLS" name="CurrentScore" style="width: 94%; font-size: 13px; color: rgb(255, 145, 0); -unity-font-definition: url(&quot;project://database/Assets/UI/Galmuri11-Condensed.ttf?fileID=12800000&amp;guid=8309e514c63e1b14abc088425cd0760b&amp;type=3#Galmuri11-Condensed&quot;); -unity-text-align: middle-center; margin-bottom: 18px;"/>
