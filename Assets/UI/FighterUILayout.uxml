        <ui:VisualElement name="ThrustGaugeFrame" style="width: 24px; height: 178px; justify-content: flex-end; background-color: rgba(0, 0, 0, 0.55); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(6, 238, 71); border-right-color: rgb(6, 238, 71); border-top-color: rgb(6, 238, 71); border-bottom-color: rgb(6, 238, 71);">
            <ui:VisualElement name="ThrustGaugeFill" style="width: 100%; height: 0%; background-color: rgb(255, 92, 0);"/>
        </ui:VisualElement>
        <ui:Label text="0%" name="ThrustGaugeValue" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Galmuri11-Condensed.ttf?fileID=12800000&amp;guid=8309e514c63e1b14abc088425cd0760b&amp;type=3#Galmuri11-Condensed&quot;); font-size: 16px; color: rgb(255, 252, 0); -unity-text-align: middle-center; margin-top: 5px;"/>
    </ui:VisualElement>
    <ui:Label text="ACE : 0" name="HighScore" parse-escape-sequences="false" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Galmuri11-Condensed.ttf?fileID=12800000&amp;guid=8309e514c63e1b14abc088425cd0760b&amp;type=3#Galmuri11-Condensed&quot;); font-size: 20px; color: rgb(255, 252, 0); align-items: auto; left: 15px; bottom: 7%; position: absolute;"/>
    <ui:VisualElement name="CombatOperatorPanel" style="display: none; position: absolute; top: 3%; left: 2%; width: 46%; height: 28%; flex-direction: row; overflow: hidden; background-color: rgba(0, 0, 0, 0.9); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(6, 238, 71); border-right-color: rgb(6, 238, 71); border-bottom-color: rgb(6, 238, 71); border-left-color: rgb(6, 238, 71);">
        <ui:VisualElement style="width: 34%; height: 100%; flex-shrink: 0; background-image: url(&quot;project://database/Assets/Image/Operator_Normal.png?fileID=-445808867132995673&amp;guid=28cd336d9b4c93143b82168ce891fa38&amp;type=3#Operator_0&quot;); -unity-background-scale-mode: scale-and-crop;"/>
